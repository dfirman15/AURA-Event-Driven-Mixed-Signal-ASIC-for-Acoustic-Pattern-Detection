#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x588454cbe550 .scope module, "tb_pulse_generator" "tb_pulse_generator" 2 3;
 .timescale -9 -12;
v0x588454cd5780_0 .var "clk", 0 0;
v0x588454cd5840_0 .var "en", 0 0;
v0x588454cd5910_0 .net "pulse_out", 0 0, L_0x588454cd5bb0;  1 drivers
v0x588454cd5a10_0 .var "signal_in", 0 0;
S_0x588454cbe6e0 .scope module, "u_pulse_gen" "pulse_generator" 2 10, 3 1 0, S_0x588454cbe550;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "en";
    .port_info 2 /INPUT 1 "signal_in";
    .port_info 3 /OUTPUT 1 "pulse_out";
L_0x588454cd5ae0 .functor NOT 1, v0x588454cd5580_0, C4<0>, C4<0>, C4<0>;
L_0x588454cd5bb0 .functor AND 1, v0x588454cd5470_0, L_0x588454cd5ae0, C4<1>, C4<1>;
v0x588454cae710_0 .net *"_ivl_0", 0 0, L_0x588454cd5ae0;  1 drivers
v0x588454cd5220_0 .net "clk", 0 0, v0x588454cd5780_0;  1 drivers
v0x588454cd52e0_0 .net "en", 0 0, v0x588454cd5840_0;  1 drivers
v0x588454cd53b0_0 .net "pulse_out", 0 0, L_0x588454cd5bb0;  alias, 1 drivers
v0x588454cd5470_0 .var "signal_d1", 0 0;
v0x588454cd5580_0 .var "signal_d2", 0 0;
v0x588454cd5640_0 .net "signal_in", 0 0, v0x588454cd5a10_0;  1 drivers
E_0x588454cbcdf0 .event posedge, v0x588454cd52e0_0, v0x588454cd5220_0;
    .scope S_0x588454cbe6e0;
T_0 ;
    %wait E_0x588454cbcdf0;
    %load/vec4 v0x588454cd52e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x588454cd5470_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x588454cd5580_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x588454cd5640_0;
    %assign/vec4 v0x588454cd5470_0, 0;
    %load/vec4 v0x588454cd5470_0;
    %assign/vec4 v0x588454cd5580_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x588454cbe550;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x588454cd5780_0;
    %inv;
    %store/vec4 v0x588454cd5780_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x588454cbe550;
T_2 ;
    %vpi_call 2 23 "$dumpfile", "gelombang_pulse.vcd" {0 0 0};
    %vpi_call 2 24 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x588454cbe550 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x588454cd5780_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x588454cd5840_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 25000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x588454cd5840_0, 0, 1;
    %delay 15000, 0;
    %vpi_call 2 34 "$display", "-->performing Scenario 1: Normal Transition" {0 0 0};
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 60000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 40000, 0;
    %vpi_call 2 40 "$display", "-->performing Scenario 2: Transition with Glitch" {0 0 0};
    %delay 13000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 8000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 50000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x588454cd5a10_0, 0, 1;
    %delay 50000, 0;
    %vpi_call 2 47 "$display", "--> Simulasi Selesai." {0 0 0};
    %vpi_call 2 48 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x588454cbe550;
T_3 ;
    %vpi_call 2 52 "$monitor", "Time=%0t | en=%b | signal_in=%b | pulse_out=%b", $time, v0x588454cd5840_0, v0x588454cd5a10_0, v0x588454cd5910_0 {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/tb_pulse_generator.v";
    "pulse_generator.v";
