C {code_shown.sym} 300 380 0 0 {name=s1 only_toplevel=false value="
.control
set color0=white  ;
set color1=black  ; 
set color5=darkgreen  ; 
noise v(Vlna) Vin dec 10 1k 10k
print inoise_total
op
tran 1u 20m
plot v(Vlna) v(Vbpf) v(Venv) v(Vout)
plot v(VbiasP) v(VbiasN) v(Vdd05)
plot v(Vdd05)
meas tran I_avg AVG I(Vdd) FROM=0.1m TO=20m
.endc
"}
