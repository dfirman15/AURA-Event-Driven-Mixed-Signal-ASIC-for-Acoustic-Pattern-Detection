+ time < 6m  ? sin(2*3.14159*3000*time)  :
+ time < 10m  ? sin(2*3.14159*5000*time)  :
+ time < 14m  ? sin(2*3.14159*7000*time)  :
+ sin(2*3.14159*9000*time) )" m=1}
